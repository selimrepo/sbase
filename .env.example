# Shared defaults for local development. Never put production secrets in Git.
POSTGRES_PASSWORD=replace-with-a-long-random-secret
# Analytics tables are stored in PostgreSQL; configure allow-list with SBASE_ANALYTICS_ALLOWED_TABLES.

# Development / optional integrations
JWT_ISSUER_URI=http://localhost:8081/realms/sbase
JWT_JWK_SET_URI=http://localhost:8081/realms/sbase/protocol/openid-connect/certs
SBASE_IMAGE=sbase:latest
MINIO_ROOT_USER=sbase-minio
MINIO_ROOT_PASSWORD=replace-with-another-long-random-secret
