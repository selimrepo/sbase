SBASE_HTTP_HOST=0.0.0.0
SBASE_HTTP_PORT=8080
SBASE_POSTGRES_URL=jdbc:postgresql://localhost:5432/sbase
SBASE_POSTGRES_USER=sbase
SBASE_POSTGRES_PASSWORD=change-me
POSTGRES_DB=sbase
POSTGRES_USER=sbase
POSTGRES_PASSWORD=change-me
CASSANDRA_PORT=9042
SOLR_PORT=8983
SBASE_CLUSTER_HOST=app
SBASE_CLUSTER_PORT=25520
SBASE_CLUSTER_BIND_HOST=0.0.0.0
SBASE_CLUSTER_BIND_PORT=25520
SBASE_CLUSTER_SEEDS=pekko://sbase@app:25520
SBASE_JOB_LEASE_SECONDS=60
SBASE_DB_POOL_SIZE=16
SPARK_MASTER=local[*]
FLINK_REST_URL=http://flink-jobmanager:8081

# Optional federated catalog connectors
SBASE_CASSANDRA_CONTACT_POINT=cassandra
SBASE_CASSANDRA_PORT=9042
SBASE_CASSANDRA_DATACENTER=datacenter1
SBASE_SOLR_URL=http://solr:8983/solr

# Admin token protects one-time deployment API key rotation (use a long random value)
SBASE_ADMIN_TOKEN=replace-with-a-long-random-admin-secret

# Durable AutoML model artifact storage
SBASE_MODEL_REGISTRY_PATH=/var/lib/sbase/models
SBASE_FEDERATED_SCAN_PARALLELISM=8

# Federated query staging and Spark spill directory
SBASE_FEDERATED_SPILL_PATH=/var/lib/sbase/spark-tmp/federation

# AutoML bounded asynchronous training queue
SBASE_AUTOML_WORKERS=2
SBASE_AUTOML_QUEUE_CAPACITY=16

# S3-compatible object storage + Apache Iceberg lakehouse (full Compose profile)
SBASE_ICEBERG_ENABLED=false
SBASE_ICEBERG_WAREHOUSE=s3://sbase-warehouse/
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace-with-a-long-minio-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_REGION=us-east-1
S3_PATH_STYLE_ACCESS=true
SPARK_DRIVER_PORT=7078
SPARK_BLOCKMANAGER_PORT=7079
